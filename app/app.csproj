<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>lgtv-display-sync</AssemblyName>
    <RootNamespace>LgtvDisplaySync.App</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon>appicon.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Update="config.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('config.json')" />
    <None Update="appicon.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- Source under scripts/; flatten to output root next to the exe. -->
    <None Include="scripts\install-service.ps1" CopyToOutputDirectory="PreserveNewest" Link="install-service.ps1" TargetPath="install-service.ps1" />
    <None Include="scripts\uninstall-service.ps1" CopyToOutputDirectory="PreserveNewest" Link="uninstall-service.ps1" TargetPath="uninstall-service.ps1" />
    <None Include="scripts\install-tray-startup.ps1" CopyToOutputDirectory="PreserveNewest" Link="install-tray-startup.ps1" TargetPath="install-tray-startup.ps1" />
    <None Include="scripts\uninstall-tray-startup.ps1" CopyToOutputDirectory="PreserveNewest" Link="uninstall-tray-startup.ps1" TargetPath="uninstall-tray-startup.ps1" />
    <None Include="scripts\install-service.cmd" CopyToOutputDirectory="PreserveNewest" Link="install-service.cmd" TargetPath="install-service.cmd" />
    <None Include="scripts\uninstall-service.cmd" CopyToOutputDirectory="PreserveNewest" Link="uninstall-service.cmd" TargetPath="uninstall-service.cmd" />
    <None Include="scripts\install-tray-startup.cmd" CopyToOutputDirectory="PreserveNewest" Link="install-tray-startup.cmd" TargetPath="install-tray-startup.cmd" />
    <None Include="scripts\uninstall-tray-startup.cmd" CopyToOutputDirectory="PreserveNewest" Link="uninstall-tray-startup.cmd" TargetPath="uninstall-tray-startup.cmd" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.7" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="9.0.7" />
  </ItemGroup>

</Project>
