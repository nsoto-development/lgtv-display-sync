<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>lgprobe</AssemblyName>
    <RootNamespace>LgtvDisplaySync.Probe</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Same git-ignored lab config the app uses (Ip/Port/KeyFile). -->
  <ItemGroup>
    <None Include="..\app\config.json" Link="config.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\app\config.json')" />
  </ItemGroup>

</Project>
